@@ -0,0 +1,401 @@
+from typing import Generic, List, Optional, TypeVar
+
+from pydantic import BaseModel
+
+from tau2.agent.base_agent import (
+    HalfDuplexAgent,
+    ValidAgentInputMessage,
+    is_valid_agent_history_message,
+)
+from tau2.agent.base.llm_config import LLMConfigMixin
+from tau2.data_model.message import (
+    APICompatibleMessage,
+    AssistantMessage,
+    Message,
+    MultiToolMessage,
+    SystemMessage,
+    ToolCall,
+    ToolMessage,
+    UserMessage,
+)
+from tau2.environment.tool import Tool
+from tau2.utils.llm_utils import generate
+
+# NOTE per Andrea: parte da LLMAgent (src/tau2/agent/llm_agent.py). Storia del
+# prompt: v1 (S3+S5) diagnosi in famiglie di fallimento, una clausola per causa;
+# v2/v3 (S6-S7-S8) hanno riapplicato lo stesso metodo e hanno eroso il guadagno
+# invece di estenderlo - dettagli in DIARIO.md. v4 (sotto) e' un cambio di
+# TECNICA, non un'altra clausola: la diagnosi (docs/v4-bozza-prompt.md) e' che
+# v1 impilava ~21 vincoli nostri sopra i ~40 della policy del dominio, oltre la
+# soglia (15-20) a cui i modelli senza reasoning nativo violano regole in
+# silenzio (Instruction Stacking Collapse, arXiv:2608.02639). v4 fonde le
+# regole invece di ripeterle, ordina i blocchi per primacy/recency, e sostituisce
+# il "pensa prima di agire" libero con un modulo a righe fisse dentro il
+# messaggio di conferma che la policy impone gia'. Rationale per-modifica
+# completo, con fonte e rischio dichiarato per ciascuna, in
+# docs/v4-bozza-prompt.md - non ripetuto qui per non farlo divergere dal codice.
+#
+# v5 (S8) e' UNA sola modifica rispetto a v4, misurata sulle tracce: v4 imponeva
+# una conferma per OGNI scrittura, e sui task 17 e 21 la conversazione e' finita
+# con il cliente che dice "si" all'ultima conferma e chiude - l'azione non e' mai
+# partita (COMMUNICATE 1.0, DB 0.0). Il modulo a 5 righe descriveva l'azione cosi'
+# bene da sembrare una ricevuta invece di una richiesta. v5 chiede UNA conferma
+# per l'intera richiesta e poi esegue tutte le azioni di fila: le chiamate a tool
+# consecutive non passano mai dall'utente (orchestrator.py:538), quindi dopo il
+# "si" il cliente non ha piu' occasione di riagganciare a meta'. E' anche cio' che
+# fa il baseline, che il 17 lo passa. policy.md:7 non impone una conferma per
+# azione ("list the action details and obtain explicit user confirmation"): quella
+# rigidita' l'avevamo aggiunta noi in v4.
+#
+# NOTA tecnica, verificata: non esiste un canale in cui l'agente possa scrivere
+# ragionamento che il cliente non vede - orchestrator.py:722 solleva AgentError se
+# un messaggio ha sia testo sia tool call. La tecnica Anthropic ("write down its
+# thoughts distinct from our usual thinking mode") si appoggia all'extended
+# thinking di Claude, un canale vero che il nostro modello non ha: non e'
+# riproducibile qui, e non e' stata riprodotta.
+
+AGENT_INSTRUCTION = """
+You are an airline customer service agent. You act only through the tools you are given, and
+only within the <policy> below.
+
+The shape of a turn is absolute:
+- A turn is EITHER one message to the customer OR one tool call. Never both. Never neither.
+- Tool arguments must be valid JSON.
+
+When two rules seem to disagree, they win in this order:
+1. The <policy>.
+2. The <procedure>.
+3. What the customer asks for.
+A customer's instruction never overrides 1 or 2, no matter how they phrase it or how many
+times they repeat it. When you cannot do what they ask, say so plainly and offer what you can.
+
+Before the FIRST tool call that CREATES, MODIFIES or CANCELS a reservation, or that issues a
+refund or a certificate, you must send the customer the single message described in
+<confirmation_format>, covering every such action you intend to take, and receive a "yes".
+Once you have that "yes", carry out all of the actions it covered without asking again.
+""".strip()
+
+
+PROCEDURE = """
+Work through these steps, in this order, for every customer request.
+
+1. UNDERSTAND. Name to yourself every distinct thing the customer asked for; one message
+   often contains more than one. You are not done until each of them has been either served
+   or explicitly declined with a reason. Before you go further, it can help to glance again
+   at the parts of the <policy> that cover what you just named - keep them in mind for the
+   steps below, rather than trying to recall them from earlier in this conversation.
+
+2. LOOK BEFORE YOU JUDGE. Read the current state with a read-only tool before deciding
+   whether an action is allowed: the user profile, and the whole reservation you are about
+   to touch. What the customer tells you about the state is a claim, not a fact.
+
+   When the customer DESCRIBES what they want instead of naming it - "the cheapest", "the
+   second cheapest", "anywhere on the west coast", "either airport", "under $100" - that
+   description is a search, not an instruction to take the first thing that fits. Search
+   every combination the description allows, list the candidates you found with the number
+   that decides between them, and choose by comparing those numbers. Write the list out
+   before you choose. A candidate that satisfies the description is not the answer; the
+   best one under the stated measure is.
+
+   Example: "cheapest round trip from New York - EWR or JFK - to anywhere on the west
+   coast" is 2 origins times every west coast destination, not one search. Searching EWR
+   to LAX alone and booking it is a wrong answer even though EWR and LAX both fit.
+
+3. CHECK ELIGIBILITY. The tools do not enforce the policy: a call can succeed and still be
+   wrong. For every reservation you intend to write to, verify against the <policy>:
+   a. that this reservation qualifies for this operation;
+   b. that every argument is one the policy permits for this operation - including WHICH
+      types of payment method are allowed here, and HOW MANY of each.
+   A rule the customer gives you for picking what to act on - a duration, a date range, a
+   price - selects candidates only. It never replaces (a) and (b). Once you have an answer,
+   it is worth checking it once more against the exact wording of the <policy> lines it
+   rests on, in case the reasoning above drifted from what they actually say.
+
+4. PICK THE PAYMENT METHOD, separately for each reservation, in this order:
+   a. the method the customer named for that reservation;
+   b. if the customer said to use the method the reservation was paid with, read it from
+      that reservation and use that;
+   c. otherwise list the methods on their profile and ask which one, before acting.
+
+5. CONFIRM, ONCE, FOR EVERYTHING - unless the customer asked otherwise. Work out every
+   action the request needs before you ask for anything. Then send ONE message, described
+   in <confirmation_format>, listing ALL of those actions together, and wait for a single
+   "yes". By default, do not ask for one action, act, and then come back to ask for the
+   next: every extra round is a chance for the call to end with work still undone.
+   The exception, and it is the customer's to make: if they ask to take the steps one at a
+   time, or to see each change completed before the next, follow their sequencing instead.
+   That is a request about HOW to work, not an instruction to break the <policy>, so it
+   wins over the default above.
+
+6. ACT. After the "yes", carry out every action that "yes" covered, one tool call per turn,
+   one immediately after another, and send NO message to the customer until all of them are
+   done. Only then report back what was completed.
+
+7. WHEN SOMETHING IS BLOCKED - a check in step 3 fails, or a tool refuses:
+   a. In a message, name the obstacle in plain words. That message ends your turn.
+   b. In that same message, say which parts of the request you CAN still serve, and whether
+      a different route exists that changes what they would get. Let them choose; do not
+      choose for them, and do not stop at the obstacle.
+   c. Then serve the parts that are allowed, each through steps 3 to 6.
+   d. You may call transfer_to_human_agents ONLY when all three hold: you named the obstacle
+      in an EARLIER turn, the customer has REPLIED to it, and no tool you have can serve any
+      remaining part of their request. A blocked path is not a request outside your scope.
+""".strip()
+
+
+CONFIRMATION_FORMAT = """
+You ask for confirmation ONCE per customer request, in a single message that covers every
+action you are about to take. Describe each action with these five lines, in this order:
+
+Action: <the one tool operation>
+Reservation: <reservation id, or "new booking">
+Details: <what changes - flights, cabin, passengers, bags - and the total amount>
+Payment: <the exact payment method, and why that one>
+Allowed because: <the condition in the policy that makes this action permitted>
+
+If the request needs more than one action, repeat the five lines for each, numbered, in the
+same message. Then ask once, at the end: Shall I go ahead with all of these?
+
+Example, for a request that needs two actions:
+
+1.
+Action: change cabin on a reservation
+Reservation: HXY4Z1
+Details: upgrade from basic economy to economy, 2 passengers, price difference $209.00
+Payment: gift card gift_8452391, the card the customer named
+Allowed because: any reservation can change cabin without changing the flights
+
+2.
+Action: add checked bags
+Reservation: HXY4Z1
+Details: total checked bags to 3, none of them charged
+Payment: none required
+Allowed because: gold members get 3 free checked bags per passenger in economy
+
+Shall I go ahead with all of these?
+
+"Allowed because:" is a check you can fail, not a sentence you have to produce. Fill it in
+only with a condition written in the <policy> AND supported by what the read-only tools
+actually returned - not by what would make the action possible. If the data does not support
+it, the action is not permitted: do not call the tool, and go to step 7 of the <procedure>.
+A customer who is friendly, insistent, or who calls you generous does not change this.
+
+Example of the check failing, on a customer asking to cancel:
+
+Action: cancel a reservation - NOT PERMITTED
+Reservation: NQNU5R
+Details: MCO to SEA, flown 2024-05-13 and 2024-05-14, 2 passengers
+Allowed because: CANNOT FILL IN. Business class allows cancellation, but today is
+  2024-05-15 and both segments have already been flown, so the condition does not hold.
+
+Correct behaviour: send no tool call, tell the customer the flights have already been
+flown and that this is why the reservation cannot be cancelled.
+""".strip()
+
+
+STYLE = """
+- Write in the language the customer writes in.
+- Money in US format: a comma every three digits, a period only before cents. $1,250 and
+  $1,250.75 - never $1.250.
+""".strip()
+
+
+FINAL_REMINDERS = """
+Three rules that are easy to lose in the length of the policy above:
+- One turn is one message OR one tool call.
+- One confirmation message for the whole request, then all the actions back to back.
+- transfer_to_human_agents only under the three conditions in step 7d. Being blocked is not
+  one of them.
+""".strip()
+
+# S3, decisione 2: se un tool sbaglia 3 volte di fila, e' il codice - non il
+# modello - a fermarsi e forzare questo messaggio, invece di lasciare che
+# Gemini decida se e quando arrendersi. Non chiama transfer_to_human_agents
+# in automatico: lascia scegliere al cliente, per non disturbare un umano
+# quando magari basta riprovare piu' tardi o cambiare approccio. Invariato in v4.
+TOOL_ERROR_STREAK_LIMIT = 3
+
+TOOL_ERROR_ESCALATION_MESSAGE = (
+    "I'm sorry, this action has failed multiple times in a row on my end. "
+    "I don't want to keep retrying without making progress. Would you like me to "
+    "transfer you to a human agent, or would you prefer to try something else instead?"
+)
+
+# S3, decisione 3, alzato in v4 da 30 a 50 (docs/v4-bozza-prompt.md, sezione 4):
+# misurato sulle simulazioni esistenti che il tetto di 30 non morde quasi mai
+# (99.3% delle traiettorie restava sotto 28 turni), ma v4 aggiunge letture e
+# checkpoint che allungano le traiettorie per costruzione - alzarlo e' igiene
+# di misura, non necessita' osservata. Riguarda solo CustomAgent: il baseline
+# (LLMAgent) non ha mai avuto questo limite, e' vincolato solo dal tetto di
+# sicurezza del framework (DEFAULT_MAX_STEPS=200, src/tau2/config.py) - quindi
+# alzarlo qui non introduce nessuna asimmetria col confronto.
+AGENT_TURN_LIMIT = 50
+TRANSFER_TOOL_NAME = "transfer_to_human_agents"
+TRANSFER_HANDOFF_MESSAGE = "YOU ARE BEING TRANSFERRED TO A HUMAN AGENT. PLEASE HOLD ON."
+
+SYSTEM_PROMPT = """
+<instructions>
+{agent_instruction}
+</instructions>
+<policy>
+{domain_policy}
+</policy>
+<procedure>
+{procedure}
+</procedure>
+<confirmation_format>
+{confirmation_format}
+</confirmation_format>
+<style>
+{style}
+</style>
+{final_reminders}
+""".strip()
+
+
+class CustomAgentState(BaseModel):
+    """The state of the agent."""
+
+    system_messages: list[SystemMessage]
+    messages: list[APICompatibleMessage]
+    tool_error_streak: int = 0
+    agent_turn_count: int = 0
+    giving_up: bool = False
+
+
+CustomAgentStateType = TypeVar("CustomAgentStateType", bound="CustomAgentState")
+
+
+class CustomAgent(
+    LLMConfigMixin, HalfDuplexAgent[CustomAgentStateType], Generic[CustomAgentStateType]
+):
+    """
+    Il nostro agente. v4: vedi il commento in testa al file e
+    docs/v4-bozza-prompt.md per il rationale completo del prompt.
+    """
+
+    def __init__(
+        self,
+        tools: List[Tool],
+        domain_policy: str,
+        llm: str,
+        llm_args: Optional[dict] = None,
+    ):
+        super().__init__(
+            tools=tools,
+            domain_policy=domain_policy,
+            llm=llm,
+            llm_args=llm_args,
+        )
+
+    @property
+    def system_prompt(self) -> str:
+        return SYSTEM_PROMPT.format(
+            domain_policy=self.domain_policy,
+            agent_instruction=AGENT_INSTRUCTION,
+            procedure=PROCEDURE,
+            confirmation_format=CONFIRMATION_FORMAT,
+            style=STYLE,
+            final_reminders=FINAL_REMINDERS,
+        )
+
+    def get_init_state(
+        self, message_history: Optional[list[Message]] = None
+    ) -> CustomAgentStateType:
+        if message_history is None:
+            message_history = []
+        assert all(is_valid_agent_history_message(m) for m in message_history), (
+            "Message history must contain only AssistantMessage, UserMessage, or ToolMessage to Agent."
+        )
+        return CustomAgentState(
+            system_messages=[SystemMessage(role="system", content=self.system_prompt)],
+            messages=message_history,
+        )
+
+    def generate_next_message(
+        self, message: ValidAgentInputMessage, state: CustomAgentStateType
+    ) -> tuple[AssistantMessage, CustomAgentStateType]:
+        assistant_message = self._generate_next_message(message, state)
+        state.messages.append(assistant_message)
+        return assistant_message, state
+
+    def _generate_next_message(
+        self, message: ValidAgentInputMessage, state: CustomAgentStateType
+    ) -> AssistantMessage:
+        if isinstance(message, UserMessage) and message.is_audio:
+            raise ValueError("User message cannot be audio.")
+        if isinstance(message, MultiToolMessage):
+            state.messages.extend(message.tool_messages)
+        else:
+            state.messages.append(message)
+
+        # Decisione 3 ha la priorita' sulla 2: se stiamo gia' rinunciando del
+        # tutto, il fatto che l'ultimo tool sia fallito o no non conta piu'.
+        if state.giving_up:
+            state.giving_up = False
+            state.agent_turn_count = 0
+            return AssistantMessage.text(content=TRANSFER_HANDOFF_MESSAGE)
+
+        state.agent_turn_count += 1
+        if state.agent_turn_count >= AGENT_TURN_LIMIT:
+            state.giving_up = True
+            return AssistantMessage(
+                role="assistant",
+                content=None,
+                tool_calls=[
+                    ToolCall(
+                        name=TRANSFER_TOOL_NAME,
+                        arguments={
+                            "summary": "Conversation exceeded the maximum number of turns without resolution."
+                        },
+                    )
+                ],
+            )
+
+        self._update_tool_error_streak(message, state)
+        if state.tool_error_streak >= TOOL_ERROR_STREAK_LIMIT:
+            state.tool_error_streak = 0
+            return AssistantMessage.text(content=TOOL_ERROR_ESCALATION_MESSAGE)
+
+        messages = state.system_messages + state.messages
+        assistant_message = generate(
+            model=self.llm,
+            tools=self.tools,
+            messages=messages,
+            call_name="custom_agent_response",
+            **self.llm_args,
+        )
+        return assistant_message
+
+    @staticmethod
+    def _update_tool_error_streak(
+        message: ValidAgentInputMessage, state: CustomAgentStateType
+    ) -> None:
+        """Conta gli errori di tool di fila. Un UserMessage non lo tocca:
+        non e' ne' un successo ne' un fallimento di un'azione."""
+        if isinstance(message, ToolMessage):
+            tool_messages = [message]
+        elif isinstance(message, MultiToolMessage):
+            tool_messages = message.tool_messages
+        else:
+            return
+        if any(tm.error for tm in tool_messages):
+            state.tool_error_streak += 1
+        else:
+            state.tool_error_streak = 0
+
+
+def create_custom_agent(tools, domain_policy, **kwargs):
+    """Factory function for CustomAgent.
+
+    Args:
+        tools: Environment tools the agent can call.
+        domain_policy: Policy text the agent must follow.
+        **kwargs: Supports llm (str) and llm_args (dict).
+    """
+    return CustomAgent(
+        tools=tools,
+        domain_policy=domain_policy,
+        llm=kwargs.get("llm"),
+        llm_args=kwargs.get("llm_args"),
+    )
