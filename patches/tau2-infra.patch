+# --- Limitatore di frequenza (modifica nostra, vedi patches/README.md) ---------
+#
+# Perche': il tier gratuito Gemini concede 15 richieste al minuto per progetto e
+# modello. Il pacing tra un task e l'altro non basta, perche' e' UN SINGOLO task a
+# superare il limite da solo: agente e simulatore-utente si alternano senza pause,
+# e nei run del 2026-09-01 abbiamo misurato fino a 18 chiamate in 24 secondi, cioe'
+# 45 al minuto. Il 429 arrivava quindi a meta' conversazione, o alla prima chiamata
+# del task successivo con la finestra ancora satura.
+#
+# Dove: `generate()` e' l'unico punto attraversato sia dall'agente
+# (agent/custom_agent.py) sia dall'utente simulato (user/user_simulator.py), quindi
+# limitare qui copre tutte le chiamate di una simulazione senza toccare altro.
+#
+# Come: finestra scorrevole, non pausa fissa. Una pausa fissa rallenterebbe anche
+# le conversazioni brevi che il limite non lo toccano mai; cosi' invece si aspetta
+# solo quando le ultime N chiamate stanno davvero saturando il minuto.
+#
+# Disattivabile: TAU2_RPM_LIMIT=0 lo spegne (per chiavi a pagamento, senza limite).
+_RPM_LIMIT = int(os.environ.get("TAU2_RPM_LIMIT", "13"))  # 13 e non 15: margine
+_RPM_WINDOW_SECONDS = 60.0
+_rpm_calls: deque[float] = deque()
+_rpm_lock = threading.Lock()
+
+
+def _throttle_rpm() -> None:
+    """Attende, se necessario, per restare sotto _RPM_LIMIT chiamate/minuto."""
+    if _RPM_LIMIT <= 0:
+        return
+    while True:
+        with _rpm_lock:
+            now = time.monotonic()
+            while _rpm_calls and now - _rpm_calls[0] >= _RPM_WINDOW_SECONDS:
+                _rpm_calls.popleft()
+            if len(_rpm_calls) < _RPM_LIMIT:
+                _rpm_calls.append(now)
+                return
+            wait = _RPM_WINDOW_SECONDS - (now - _rpm_calls[0]) + 0.05
+        logger.info(
+            f"Rate limit locale: attendo {wait:.1f}s "
+            f"({len(_rpm_calls)}/{_RPM_LIMIT} chiamate nell'ultimo minuto)"
+        )
+        time.sleep(wait)
+
