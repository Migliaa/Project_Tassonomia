diff --git a/src/tau2/utils/langfuse_tracing.py b/src/tau2/utils/langfuse_tracing.py
new file mode 100644
index 0000000..284dfbd
--- /dev/null
+++ b/src/tau2/utils/langfuse_tracing.py
@@ -0,0 +1,215 @@
+"""Langfuse trace shaping for benchmark runs.
+
+By default every LLM call LiteLLM makes becomes its own top-level Langfuse
+trace, so a single task shows up as a dozen unrelated rows and there is no way
+to tell a failed task from a passing one without opening each row.
+
+This module gives a run the shape you actually want to read:
+
+    Trace "Check that Agent verifies membership status..."   [score: reward=0]
+      |- agent_response          -> get_user_details
+      |- user_simulator_response
+      |- agent_response          -> get_reservation_details
+
+It works by opening one OpenTelemetry span around each simulation and handing
+that span to LiteLLM explicitly, via `litellm_parent_otel_span` in the call
+metadata ("Priority 1" in `_get_span_context`, litellm/integrations/
+opentelemetry.py). LiteLLM then creates its spans as children of it, so the
+whole conversation lands in one trace. It also stops emitting its extra
+`litellm_request` wrapper span once a parent exists, which otherwise duplicates
+every row.
+
+Two things that look like they should work but don't:
+
+- Passing a `trace_id` in the metadata does NOT group calls. In OpenTelemetry
+  trace membership comes from the span context, not from an attribute, so a
+  `trace_id` passed this way is only ever stored as a label.
+- Relying on LiteLLM to pick up the active span from the ambient context
+  ("Priority 3") does NOT work either: it logs calls from a different thread,
+  and the OpenTelemetry context is per-thread, so by then no span is active.
+  Hence passing the span object explicitly.
+"""
+
+import os
+import random
+from contextlib import contextmanager
+from typing import Optional
+
+from loguru import logger
+
+from tau2.config import USE_LANGFUSE
+from tau2.data_model.tasks import Task
+from tau2.utils.llm_utils import set_llm_trace_metadata
+
+_client = None
+_client_resolved = False
+
+
+@contextmanager
+def _unseeded_randomness():
+    """
+    Temporarily restore genuine randomness to the global `random` module.
+
+    tau2 seeds it for reproducible simulations, and OpenTelemetry's default id
+    generator draws trace and span ids from that same module — so every run of a
+    task is handed *identical* ids. Langfuse groups observations purely by trace
+    id (there is no separate trace entity in v4), so without this every run of a
+    given task merges into one ever-growing trace.
+
+    The previous RNG state is restored on exit, so simulation reproducibility is
+    unaffected.
+    """
+    state = random.getstate()
+    random.seed(os.urandom(16))
+    try:
+        yield
+    finally:
+        random.setstate(state)
+
+
+def task_trace_name(task: Task) -> str:
+    """
+    Human-readable trace name: what this task actually tests.
+
+    Falls back to the id when a task carries no purpose, since an opaque name
+    is still better than every trace being called "litellm_request".
+    """
+    purpose = None
+    description = getattr(task, "description", None)
+    if description is not None:
+        purpose = getattr(description, "purpose", None)
+    if not purpose:
+        return f"task {task.id}"
+    purpose = " ".join(str(purpose).split())
+    if len(purpose) > 100:
+        purpose = purpose[:97] + "..."
+    return purpose
+
+
+def trace_metadata_for_task(
+    task: Task, simulation_id: str, domain: Optional[str] = None
+) -> dict:
+    """
+    Metadata attached to every LLM call of a simulation, so a trace can be
+    found by task and a run's calls can be grouped into a session.
+    """
+    tags = ["tau2", f"task-{task.id}"]
+    if domain:
+        tags.append(domain)
+    return {
+        "trace_name": task_trace_name(task),
+        "session_id": f"task_{task.id}_sim_{simulation_id}",
+        "tags": tags,
+        "trace_metadata": {"task_id": str(task.id), "simulation_id": simulation_id},
+    }
+
+
+def _get_client():
+    """
+    Build a Langfuse client from the env, or None if it isn't configured.
+
+    Cached: constructing a client sets up an OpenTelemetry tracer provider, so
+    one per process is both enough and correct. The OTel exporter reads
+    LANGFUSE_OTEL_HOST while this SDK reads LANGFUSE_HOST; accept either so a
+    single setting drives both.
+    """
+    global _client, _client_resolved
+    if _client_resolved:
+        return _client
+    _client_resolved = True
+    try:
+        from langfuse import Langfuse
+
+        public_key = os.environ.get("LANGFUSE_PUBLIC_KEY")
+        secret_key = os.environ.get("LANGFUSE_SECRET_KEY")
+        if not public_key or not secret_key:
+            return None
+        host = os.environ.get("LANGFUSE_HOST") or os.environ.get("LANGFUSE_OTEL_HOST")
+        kwargs = {
+            "public_key": public_key,
+            "secret_key": secret_key,
+            # Without this, the SDK's default OTLP exporter still uses v3's
+            # delayed ingestion path even though the SDK itself is v4.
+            "additional_headers": {"x-langfuse-ingestion-version": "4"},
+        }
+        if host:
+            kwargs["host"] = host if host.startswith("http") else f"https://{host}"
+        _client = Langfuse(**kwargs)
+    except Exception as e:
+        logger.warning(f"Langfuse client unavailable, tracing disabled: {e}")
+        _client = None
+    return _client
+
+
+class simulation_trace:
+    """
+    Wraps one simulation in a single Langfuse trace named after the task.
+
+    Degrades to a no-op when Langfuse is disabled or unreachable: a tracing
+    problem must never fail a benchmark run.
+    """
+
+    def __init__(self, task: Task, simulation_id: str):
+        self.task = task
+        self.simulation_id = simulation_id
+        self._cm = None
+        self._span = None
+
+    def __enter__(self):
+        if not USE_LANGFUSE:
+            return self
+        client = _get_client()
+        if client is None:
+            return self
+        try:
+            with _unseeded_randomness():
+                self._cm = client.start_as_current_observation(
+                    name=task_trace_name(self.task),
+                    as_type="span",
+                    metadata={
+                        "task_id": str(self.task.id),
+                        "simulation_id": self.simulation_id,
+                    },
+                )
+                self._span = self._cm.__enter__()
+            metadata = trace_metadata_for_task(self.task, self.simulation_id)
+            # Handing LiteLLM the span object is what actually nests the calls;
+            # it logs from another thread, where the ambient context is empty.
+            metadata["litellm_parent_otel_span"] = self._span._otel_span
+            set_llm_trace_metadata(metadata)
+        except Exception as e:
+            logger.warning(f"Could not open Langfuse trace: {e}")
+            self._cm = self._span = None
+        return self
+
+    def record_reward(self, reward: Optional[float]) -> None:
+        """
+        Attach the simulation's reward to its trace as a score.
+
+        This is what makes failure analysis tractable: filter on the score to
+        get the failed runs, instead of opening traces one by one.
+        """
+        if self._span is None or reward is None:
+            return
+        try:
+            self._span.score_trace(
+                name="reward",
+                value=float(reward),
+                data_type="NUMERIC",
+                comment=task_trace_name(self.task),
+            )
+        except Exception as e:
+            logger.warning(f"Could not record reward score: {e}")
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        set_llm_trace_metadata(None)
+        if self._cm is None:
+            return False
+        try:
+            self._cm.__exit__(exc_type, exc_val, exc_tb)
+            client = _get_client()
+            if client is not None:
+                client.flush()
+        except Exception as e:
+            logger.warning(f"Could not close Langfuse trace: {e}")
+        return False
